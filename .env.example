# Asaas (checkout via API, Pix e cartão)
ASAAS_API_KEY=
# "sandbox" (padrão) ou "production"
ASAAS_ENV=sandbox
# Token configurado no webhook do Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# Google Sheets (conta de serviço, sem Google Forms)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave privada do JSON da conta de serviço. Mantenha as quebras de linha como \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Links wa.me (apenas números com DDI+DDD, sem formatação)
NEXT_PUBLIC_WHATSAPP_HUGO=
NEXT_PUBLIC_WHATSAPP_ELIANE=

# Site institucional da Foco Gestão Contábil (rodapé/cabeçalho)
NEXT_PUBLIC_FOCO_INSTITUCIONAL_URL=https://www.focogestaocontabil.com.br
